{
  // Niveles mínimos de mensajes que se escribirán en consola.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // "*" permite cualquier Host HTTP en este ejemplo local.
  "AllowedHosts": "*",

  // WeatherRpcWorker enlaza esta sección con RabbitMqOptions al arrancar.
  "RabbitMq": {
    // Con dotnet run conecta al puerto publicado en Windows. Dentro de Compose,
    // la variable RabbitMq__HostName lo cambia por el servicio "rabbitmq".
    "HostName": "localhost",

    // Puerto AMQP del broker; 15672 pertenece únicamente al panel web.
    "Port": 5672,

    // Credenciales locales declaradas también en compose.yaml.
    "UserName": "app",
    "Password": "app",

    // Debe coincidir con el virtual host usado por el Gateway.
    "VirtualHost": "/",

    // Cola que este proceso declara y mantiene consumiendo.
    "RequestQueue": "rpc.weather",

    // La opción es compartida con Gateway; quien aplica este timeout es el cliente RPC.
    "RequestTimeoutSeconds": 10
  }
}
